{
  "name": "backend",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc -b tsconfig.build.json && tsc-alias",
    "postbuild": "mkdir dist/modules/api/docs && cp src/modules/api/docs/swagger.yaml dist/modules/api/docs/",
    "start": "node .",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts | pino-pretty",
    "start:watch": "tsnd -r tsconfig-paths/register --respawn --transpile-only src/main.ts | pino-pretty",
    "test": "jest --runInBand",
    "test:cov": "jest --runInBand --coverage"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@newrelic/mysql": "^6.1.0",
    "axios": "^1.20.0",
    "bullmq": "^6.3.4",
    "cheerio": "^1.2.0",
    "cron": "^4.4.0",
    "fastify": "^5.12.3",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.28.17",
    "mysql2": "^3.24.3",
    "newrelic": "^14.3.10",
    "node-cache": "^5.1.2",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.1",
    "@packages/testing": "workspace:*",
    "@packages/types": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/newrelic": "^9.14.8",
    "@types/node": "^26.4.1",
    "jest": "^30.5.1",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.9.4",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  }
}
